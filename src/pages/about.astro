---
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="About | Stephen Abbot"
	description="About Stephen Abbot Lorem Ipsum"
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Stephen Abbot at work with a colleague"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I began my career as principal architect at Digital Equipment Corporation, designing enterprise-scale distributed systems before transitioning to operations to understand how systems actually behave in production. This combination of architectural thinking and operational reality shapes my approach to building reliable, scalable solutions.
					</p>
					<p>
						Today, I focus on leveraging AI collaboration to accelerate solution delivery while maintaining enterprise-grade quality. My philosophy is simple: demonstrate capability through actual solutions rather than claims. Every project in my portfolio represents real-world problem-solving at scale.
					</p>
					<p>
						Based in Denver, Colorado, I'm passionate about helping engineering teams build foundational practices that prevent technical debt and enable sustainable growth. Whether it's designing observability frameworks, automating compliance workflows, or mentoring teams on AWS best practices, I believe in solutions that work today and scale for tomorrow.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>AWS Certified Cloud Practitioner and AI Practitioner with continuous learning focus on emerging technologies and architectural patterns.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p>Enterprise-scale AWS architecture, site reliability engineering, observability platform design, AI-enhanced development workflows, and team enablement through foundational practices.</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
